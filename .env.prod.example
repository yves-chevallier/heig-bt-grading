# Copier en .env.prod sur la VM (chmod 600), jamais dans git.
# PUBLIC_URL, HOST, PORT et DATABASE_PATH sont fixés par compose.prod.yml.

# Compte admin local (secours si l'IdP est indisponible).
# Hash : pnpm admin:password — conserver les apostrophes.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=''

# SWITCH edu-ID, authentification client private_key_jwt (ES256).
# La clé publique correspondante est enregistrée auprès de l'AAI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PRIVATE_KEY_PATH=/app/secrets/eduid-private-key.pem
OIDC_PRIVATE_KEY_KID=tb-eduid-2026
