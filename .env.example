HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=./data/evaluations.sqlite
# Générer avec npm run admin:password, puis coller la valeur entre apostrophes.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD_HASH=''
# Facultatif en local. En production : URL HTTPS et client OpenID enregistré.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Pour SWITCH edu-ID : clé privée EC P-256, comme heig-classroom.
OIDC_PRIVATE_KEY_PATH=
OIDC_PRIVATE_KEY_KID=
